import("//build/test.gni")
import("../../../../../appexecfwk.gni")

module_output_path = "bundle_framework/bundle_framework"

ohos_unittest("BmsSkillManagerHelperTest") {
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  use_exceptions = true
  module_out_path = module_output_path
  include_dirs = [
    "${kits_path}/js/common",
    "${kits_path}/js/skill_manager",
  ]
  sources = [
    "bms_skill_manager_helper_test.cpp",
    "${kits_path}/js/skill_manager/skill_manager_helper.cpp",
  ]

  defines = [
    "APP_LOG_TAG = \"BMS\"",
    "LOG_DOMAIN = 0xD001120",
  ]

  deps = [
    "${base_path}:appexecfwk_base",
    "${common_path}:libappexecfwk_common",
    "${core_path}:appexecfwk_core",
    "${kits_path}/js/common:bundle_napi_common",
  ]

  external_deps = [
    "ability_base:want",
    "c_utils:utils",
    "googletest:gtest_main",
    "hilog:libhilog",
    "ipc:ipc_core",
    "libuv:uv",
    "napi:ace_napi",
    "node:node_header_notice",
    "safwk:api_cache_manager",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":BmsSkillManagerHelperTest" ]
}
