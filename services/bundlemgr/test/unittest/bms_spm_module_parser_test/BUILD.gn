import("//build/test.gni")
import("../../../../../appexecfwk.gni")

module_output_path = "bundle_framework/bundle_framework"

ohos_unittest("SpmModuleParserTest") {
  sanitize = {
    cfi = true
    cfi_cross_dso = true
    debug = false
  }
  use_exceptions = true
  module_out_path = module_output_path

  sources = [ "spm_module_parser_test.cpp" ]

  include_dirs = [
    "${common_path}/log/include",
    "${inner_api_path}/appexecfwk_base/include",
    "${services_path}/bundlemgr/include",
  ]

  defines = [
    "APP_LOG_TAG = \"BMS\"",
    "LOG_DOMAIN = 0xD001120",
  ]

  ldflags = [ "-Wl,--lto-O2" ]

  deps = [ "${services_path}/bundlemgr/spm_module_parser" ]

  cflags = []
  if (target_cpu == "arm") {
    cflags += [ "-DBINDER_IPC_32BIT" ]
  }

  external_deps = [
    "c_utils:utils",
    "googletest:gmock_main",
    "googletest:gtest_main",
    "hilog:libhilog",
  ]
}

group("unittest") {
  testonly = true
  deps = [ ":SpmModuleParserTest" ]
}
