import("//build/test.gni")
import("../../../../appexecfwk.gni")
import("../../../../services/bundlemgr/appexecfwk_bundlemgr.gni")

module_output_path = fuzz_test_path

ohos_fuzztest("BMSPatchParserFuzzTest") {
  fuzz_config_file = "../../../fuzztest/fuzztest_bundlemanager/bmspatchparser_fuzzer"
  use_exceptions = true
  module_out_path = module_output_path
  include_dirs = [
    "${test_path}/fuzztest",
    "${services_path}/bundlemgr/include",
  ]

  sources = [
    "${services_path}/bundlemgr/src/bundle_util.cpp",
    "bmspatchparser_fuzzer.cpp",
  ]

  configs = [ "${services_path}/bundlemgr/test:bundlemgr_test_config" ]
  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]

  deps = [
    "${base_path}:appexecfwk_base",
    "${common_path}:libappexecfwk_common",
    "${core_path}:appexecfwk_core",
    "${services_path}/bundlemgr:bundle_parser",
  ]

  external_deps = [
    "ability_base:want",
    "access_token:libprivacy_sdk",
    "access_token:libtokenid_sdk",
    "appverify:libhapverify",
    "bounds_checking_function:libsec_shared",
    "dfs_service:libdecompress",
    "ffrt:libffrt",
    "hilog:libhilog",
    "hitrace:hitrace_meter",
    "init:libbegetutil",
    "ipc:ipc_core",
    "json:nlohmann_json_static",
    "zlib:shared_libz",
  ]
  external_deps += bundle_install_external_deps

  defines = []
  if (bundle_framework_quick_fix) {
    defines += [ "BUNDLE_FRAMEWORK_QUICK_FIX" ]
  }
  if (storage_service_enable) {
    external_deps += [ "storage_service:storage_manager_sa_proxy" ]
    defines += [ "STORAGE_SERVICE_ENABLE" ]
  }
}
