import("//build/config/features.gni")
import("//build/ohos.gni")
import("//build/test.gni")
import("../../../../appexecfwk.gni")
import("../../../../services/bundlemgr/appexecfwk_bundlemgr.gni")

module_output_path = fuzz_test_path

ohos_fuzztest("BMSBundleParserFuzzTest") {
  fuzz_config_file = "../../../fuzztest/fuzztest_bundlemanager/bmsbundleparser_fuzzer"
  use_exceptions = true
  module_out_path = module_output_path
  include_dirs = [
    "${test_path}/fuzztest",
    "${services_path}/bundlemgr/include",
    "${services_path}/bundlemgr/include/rpcid_decode",
  ]

  sources = bundle_mgr_source
  sources += bundle_install_sources
  sources += [
    "${services_path}/bundlemgr/src/bundle_extractor.cpp",
    "${services_path}/bundlemgr/src/bundle_parser.cpp",
    "${services_path}/bundlemgr/src/bundle_profile.cpp",
    "${services_path}/bundlemgr/src/default_permission_profile.cpp",
    "${services_path}/bundlemgr/src/module_profile.cpp",
    "${services_path}/bundlemgr/src/pre_bundle_profile.cpp",
    "${services_path}/bundlemgr/src/base_extractor.cpp",
    "${services_path}/bundlemgr/src/zip_file.cpp",
    "${services_path}/bundlemgr/src/rpcid_decode/syscap_tool.c",
    "bmsbundleparser_fuzzer.cpp",
  ]

  if (bundle_framework_quick_fix) {
    sources += [
      "${services_path}/bundlemgr/src/quick_fix/patch_extractor.cpp",
      "${services_path}/bundlemgr/src/quick_fix/patch_parser.cpp",
      "${services_path}/bundlemgr/src/quick_fix/patch_profile.cpp",
    ]
  }

  configs = [ "${services_path}/bundlemgr/test:bundlemgr_test_config" ]
  configs += [ "${services_path}/bundlemgr:rdb_config" ]
  cflags = [
    "-g",
    "-O0",
    "-Wno-unused-variable",
    "-fno-omit-frame-pointer",
  ]

  deps = [
    "${base_path}:appexecfwk_base",
    "${common_path}:libappexecfwk_common",
    "${core_path}:appexecfwk_core",
    "${extension_path}:bundlemgr_extension",
  ]

  external_deps = [
    "ability_base:want",
    "ability_runtime:ability_manager",
    "ability_runtime:app_manager",
    "access_token:el5_filekey_manager_sdk",
    "access_token:libaccesstoken_sdk",
    "access_token:libprivacy_sdk",
    "access_token:libtokenid_sdk",
    "appspawn:hnpapi",
    "appverify:libhapverify",
    "battery_manager:batterysrv_client",
    "bounds_checking_function:libsec_shared",
    "c_utils:utils",
    "common_event_service:cesfwk_core",
    "common_event_service:cesfwk_innerkits",
    "dfs_service:libdecompress",
    "eventhandler:libeventhandler",
    "ffrt:libffrt",
    "hilog:libhilog",
    "hitrace:hitrace_meter",
    "init:libbegetutil",
    "ipc:ipc_core",
    "jsoncpp:jsoncpp",
    "relational_store:native_rdb",
    "safwk:system_ability_fwk",
    "samgr:samgr_proxy",
    "selinux:libselinux",
    "selinux_adapter:librestorecon",
    "syscap_codec:syscap_interface_shared",
    "thermal_manager:thermalsrv_client",
    "zlib:shared_libz",
  ]
  external_deps += bundle_install_external_deps

  sources += [
    "${services_path}/bundlemgr/src/bundle_data_storage_rdb.cpp",
    "${services_path}/bundlemgr/src/preinstall_data_storage_rdb.cpp",
    "${services_path}/bundlemgr/src/rdb/bms_rdb_open_callback.cpp",
    "${services_path}/bundlemgr/src/rdb/rdb_data_manager.cpp",
  ]

  defines = []
  if (bundle_framework_app_control) {
    defines += [ "BUNDLE_FRAMEWORK_APP_CONTROL" ]
  }
  if (bundle_framework_quick_fix) {
    defines += [ "BUNDLE_FRAMEWORK_QUICK_FIX" ]
  }
  if (bundle_framework_free_install) {
    defines += [ "BUNDLE_FRAMEWORK_FREE_INSTALL" ]
  }
  if (storage_service_enable) {
    defines += [ "STORAGE_SERVICE_ENABLE" ]
  }

  defines = []
  if (storage_service_enable) {
    external_deps += [ "storage_service:storage_manager_sa_proxy" ]
    defines += [ "STORAGE_SERVICE_ENABLE" ]
  }
}
