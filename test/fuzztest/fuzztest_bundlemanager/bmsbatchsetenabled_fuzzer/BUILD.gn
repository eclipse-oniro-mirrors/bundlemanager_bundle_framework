import("//build/test.gni")

module_output_path = "bundle_framework/bmsbatchsetenabled_fuzzer"

ohos_fuzztest("BmsBatchSetEnabledFuzzTest") {
  module_out_path = module_output_path
  fuzz_config_file = "project.xml"
  include_dirs = [
    "${inner_api_path}/appexecfwk_core/include/bundlemgr",
    "${inner_api_path}/appexecfwk_base/include",
    "${services_path}/bundlemgr/include",
    "${bundle_framework_path}/test/fuzztest/fuzztest_bundlemanager",
  ]

  sources = [
    "bmsbatchsetenabled_fuzzer.cpp",
  ]

  configs = [
    "${services_path}/bundlemgr:bundlemgr_common_config",
  ]

  cflags = [ "-fno-rtti" ]
  cflags_cc = [ "-fno-rtti" ]

  external_deps = [
    "ability_base:want",
    "c_utils:utils",
    "hilog:libhilog",
    "ipc:ipc_core",
  ]
}
